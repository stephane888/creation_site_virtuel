{#
/**
 * @file hbk_collection.html.twig
 * Default theme implementation to present Collection by Habeuk data.
 *
 * This template is used when viewing Collection by Habeuk pages.
 *
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_hbk_collection()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes.addClass('hbk_collection') }}>
  {% if content %}
    {{- content -}}
  {% endif %}
</div>
