function creation_site_virtuel_field_widget_creationsitevirtuelcomplexinline_form_alter(&$element, \Drupal\Core\Form\FormStateInterface $form_state, $context) {
  /**
   *
   * @var \Drupal\Core\Field\FieldItemListInterface $items
   */
  $items = $context['items'];
  
  // On n'essaie de faire des copie de contenus.
  if ($items->getEntity()->isNew()) {
    /**
     *
     * @var \Drupal\creation_site_virtuel\Plugin\Field\FieldWidget\CreationSiteVirtuelComplexInline $widget
     */
    $widget = $context['widget'];
    $ief_id = $widget->_getIefId();
    $entities = $form_state->get([
      'inline_entity_form',
      $ief_id,
      'entities'
    ]);
    if ($form_state->getTriggeringElement()) {
      // \Stephane888\Debug\debugLog::$max_depth = 4;
      // \Stephane888\Debug\debugLog::kintDebugDrupal($element,
      // 'getTriggeringElement', true);
      $element['#access'] = false;
      $element = [
        [
          '#theme' => 'status_messages',
          '#message_list' => [
            "warning" => [
              'Cliquez sur sur le bouton ci-dessous ( " Creation de ... " ) afin de generer votre contenu.',
              'Cela peut prendre quelques minutes en fonction de la taille des contenus à generer '
            ]
          ]
        ],
        $element
      ];
    }
    // uniquement lors de la creation d'un contenu, on duplique les contenus
    // definies par defaut.
    elseif (!$form_state->get('default_value_widget') && !$form_state->getTriggeringElement()) {
      
      if (!empty($entities)) {
        $field_access = \Drupal\domain_access\DomainAccessManagerInterface::DOMAIN_ACCESS_FIELD;
        $field_source = \Drupal\domain_source\DomainSourceElementManagerInterface::DOMAIN_SOURCE_FIELD;
        $setFields = [
          $field_access => lesroidelareno::getCurrentDomainId(),
          $field_source => lesroidelareno::getCurrentDomainId()
        ];
        $uid = \Drupal::currentUser()->id();
        $subDatas = [];
        /**
         *
         * @var \Drupal\apivuejs\Services\DuplicateEntityReference $duplicate_reference
         */
        $duplicate_reference = \Drupal::service('apivuejs.duplicate_reference');
        // On met à jour les données present dans $form_state.
        foreach ($entities as $k => $entity) {
          /**
           *
           * @var \Drupal\commerce_product\Entity\Product $cloneNode
           */
          $cloneNode = $entity['entity']->createDuplicate();
          // On verifie si l'entité a le champs domain acces,
          if ($cloneNode->hasField($field_access)) {
            $cloneNode->set($field_access, lesroidelareno::getCurrentDomainId());
          }
          if ($cloneNode->hasField($field_source)) {
            $cloneNode->set($field_source, lesroidelareno::getCurrentDomainId());
          }
          // Les variations de produits ne sont pas duppliquer
          if ($cloneNode->getEntityTypeId() == 'commerce_product') {
            $duplicate_reference->duplicateProduct($entity['entity'], $cloneNode, true, $uid, $subDatas);
          }
          else {
            $cloneNode = $duplicate_reference->duplicateEntity($cloneNode, false, [], $setFields);
          }
          $entities[$k]['needs_save'] = true;
          $entities[$k]['form'] = null;
          $entities[$k]['entity'] = $cloneNode;
        }
        //
        $form_state->set([
          'inline_entity_form',
          $ief_id,
          'entities'
        ], $entities);
        // On met à jour les données present dans le bloc d'affichage.
        foreach ($element['entities'] as $k => $entity) {
          if (!empty($entity['#entity'])) {
            /**
             *
             * @var \Drupal\node\Entity\Node $node
             */
            $node = $element['entities'][$k]['#entity'];
            $cloneNodeDisplay = $node->createDuplicate();
            if ($cloneNodeDisplay->hasField($field_access)) {
              $cloneNodeDisplay->set($field_access, lesroidelareno::getCurrentDomainId());
            }
            if ($cloneNodeDisplay->hasField($field_source)) {
              $cloneNodeDisplay->set($field_source, lesroidelareno::getCurrentDomainId());
            }
            $element['entities'][$k]['#entity'] = $cloneNodeDisplay;
            $element['entities'][$k]['#needs_save'] = true;
          }
        }
      }
      else {
        $message = "Aucun contenu par defaut pour le champs : " . $items->getName();
        \Drupal::messenger()->addStatus($message);
      }
    }
    // $form_values = NestedArray::getValue($form_state->getValues(),
    // $reference_form['#parents']);
  }
  else {
    // $widget = $context['widget'];
    // $ief_id = $widget->_getIefId();
    // $entities = $form_state->get([
    // 'inline_entity_form',
    // $ief_id,
    // 'entities'
    // ]);
    
    // foreach ($entities as $vals) {
    // foreach ($vals as $entity) {
    // /**
    // *
    // * @var \Drupal\block_content\Entity\BlockContent $entity
    // */
    // if ($entity instanceof Drupal\block_content\Entity\BlockContent &&
    // $entity->getEntityTypeId() == 'block_content') {
    
    // }
    // }
    // }
  }
}


