/**
 * Ajouter la traduction sur les champs name de site_internet_entity et
 * site_type_datas.
 * implement hook_update_8001
 *
 * @see https://www.drupal.org/node/2554097
 */
function ___creation_site_virtuel_update_8001() {
  /**
   *
   * @var \Drupal\Core\Entity\EntityDefinitionUpdateManagerInterface $updateManager
   */
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  /**
   *
   * @var \Drupal\Core\Field\BaseFieldDefinition $nameModelCv
   */
  $nameSiteInternetEntity = $updateManager->getFieldStorageDefinition('name', 'site_internet_entity');
  $nameSiteInternetEntity->setTranslatable(true);
  $nameSiteInternetEntity->setSetting('max_length', 250);
  $updateManager->updateFieldStorageDefinition($nameSiteInternetEntity);
  /**
   *
   * @var \Drupal\Core\Field\BaseFieldDefinition $nameModelCv
   */
  $nameSiteTypeDatas = $updateManager->getFieldStorageDefinition('name', 'site_type_datas');
  $nameSiteTypeDatas->setTranslatable(true);
  $nameSiteTypeDatas->setSetting('max_length', 250);
  $updateManager->updateFieldStorageDefinition($nameSiteTypeDatas);
}

/**
 * Update value max_length from 50 to 250.
 *
 * implement hook_update_8001
 *
 * @see https://www.drupal.org/node/2554097
 */
function __creation_site_virtuel_update_name_max_length($entity_type_id) {
  // Retrieve existing field data.
  $database = \Drupal::database();
  $names = $database->select($entity_type_id . '_field_data', 'et')->fields('et', [
    'id',
    'langcode',
    'name'
  ])->execute()->fetchAll(\PDO::FETCH_ASSOC);
  // Remove data from the column.
  $database->update($entity_type_id . '_field_data')->fields([
    'name' => NULL
  ])->execute();
  // Remove old definition field.
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $storagedef = $updateManager->getFieldStorageDefinition('name', $entity_type_id);
  $updateManager->uninstallFieldStorageDefinition($storagedef);
  // Load new definition field in code.
  /**
   *
   * @var \Drupal\Core\Entity\EntityFieldManager $fieldManager
   */
  $fieldManager = \Drupal::service('entity_field.manager');
  $fields = $fieldManager->getFieldStorageDefinitions($entity_type_id);
  $updateManager->installFieldStorageDefinition('name', $entity_type_id, "creation_site_virtuel", $fields['name']);
  // Restore entity data in the new schema.
  foreach ($names as $name) {
    $database->update($entity_type_id . '_field_data')->fields([
      'name' => $name['name']
    ])->condition('id', $name['id'])->condition('langcode', $name['langcode'])->execute();
  }
}

/**
 * Update value max_length from 50 to 250.
 *
 * implement hook_update_8001
 *
 * @see https://www.drupal.org/node/2554097
 */
function creation_site_virtuel_update_8001() {
  __creation_site_virtuel_update_name_max_length('site_type_datas');
  __creation_site_virtuel_update_name_max_length('site_internet_entity');
}

/**
 * implement hook_entity_base_field_info
 *
 * @param EntityTypeInterface $entity_type
 */
function creation_site_virtuel_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];
  if ($entity_type->id() == 'site_internet_entity') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'paragraph') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'block_content') {
    $fields['layout_paragraphs'] = BaseFieldDefinition::create('entity_reference')->setLabel(t(' Sections (@Depreciate) '))->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)->setDisplayOptions('form', [
      'type' => 'creationsitevirtuelcomplexinline',
      'weight' => 0
    ])->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setSetting('target_type', 'paragraph')->setSetting('handler', 'default')->setTranslatable(true)->setSetting('allow_duplicate', true);
    $fields['user_id'] = BaseFieldDefinition::create('entity_reference')->setLabel(t(' User Name '))->setRequired(TRUE)->setDescription(t('The Name of the associated user.'))->setSetting('target_type', 'user')->setSetting('handler', 'default')->setDisplayOptions('view', array(
      'label' => 'above',
      'type' => 'entity_reference_label',
      'weight' => -3
    ))->setDisplayOptions('form', [
      'type' => 'entity_reference_autocomplete',
      'settings' => array(
        'match_operator' => 'CONTAINS',
        'size' => 60,
        'autocomplete_type' => 'tags',
        'placeholder' => ''
      ),
      'weight' => -3
    ])->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setDefaultValueCallback('\Drupal\creation_site_virtuel\CreationSiteVirtuel::getCurrentUser');
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_product') {
    $fields['layout_paragraphs'] = BaseFieldDefinition::create('entity_reference')->setLabel(t(' Sections (@Depreciate) '))->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)->setDisplayOptions('form', [
      'type' => 'creationsitevirtuelcomplexinline',
      'weight' => 39
    ])->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setSetting('target_type', 'paragraph')->setSetting('handler', 'default')->setTranslatable(true)->setSetting('allow_duplicate', true);
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_payment') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_payment_method') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_order') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_order_item') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_promotion') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_promotion_coupon') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_shipping_method') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_shipment') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_stock_location') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'commerce_store') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'blocks_contents') {
    __creation_site_virtuel_fields_domain($fields);
  }
  elseif ($entity_type->id() == 'bks_autoecole_heures') {
    __creation_site_virtuel_fields_domain($fields);
  }
  //
  elseif ($entity_type->id() == 'booking_reservation') {
    __creation_site_virtuel_fields_domain($fields);
  }
  // elseif ($entity_type->id() == 'dis_period_entity') {
  // __creation_site_virtuel_fields_domain($fields);
  // }
  // elseif ($entity_type->id() == 'equipes_entity') {
  // __creation_site_virtuel_fields_domain($fields);
  // }
  // elseif ($entity_type->id() == 'submit_rdv_entity') {
  // __creation_site_virtuel_fields_domain($fields);
  // }
  return $fields;
}

/**
 *
 * @param array $fields
 */
function __creation_site_virtuel_fields_domain(array &$fields) {
  if (\Drupal::moduleHandler()->moduleExists('domain')) {
    $field_access = \Drupal\domain_access\DomainAccessManagerInterface::DOMAIN_ACCESS_FIELD;
    $field_source = \Drupal\domain_source\DomainSourceElementManagerInterface::DOMAIN_SOURCE_FIELD;
    //
    $fields[$field_access] = BaseFieldDefinition::create('entity_reference')->setLabel(t(" Domain access "))->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)->setTranslatable(false)->setDisplayOptions('form', [
      'type' => 'select2_entity_reference',
      'weight' => 40,
      'settings' => [
        'autocomplete' => true
      ]
    ])->setSetting('handler', 'default')->setSetting('target_type', 'domain')->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setDefaultValueCallback('\Drupal\creation_site_virtuel\CreationSiteVirtuel::getActiveDomain');
    //
    $fields[$field_source] = BaseFieldDefinition::create('entity_reference')->setLabel(t(" Domain source "))->setDisplayOptions('form', [
      'type' => 'options_select',
      'weight' => 40
    ])->setSetting('handler', 'default')->setSetting('target_type', 'domain')->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setTranslatable(false);
  }
}

/**
 * Implements hook_theme().
 */
function creation_site_virtuel_theme() {
  $theme = [];
  $theme['site_internet_entity'] = [
    'render element' => 'elements',
    'file' => 'site_internet_entity.page.inc',
    'template' => 'site_internet_entity'
  ];
  $theme['site_internet_entity_content_add_list'] = [
    'render element' => 'content',
    'variables' => [
      'content' => NULL
    ],
    'file' => 'site_internet_entity.page.inc'
  ];
  $theme['site_internet_entity_edit_form'] = [
    'render element' => 'form'
  ];
  return $theme;
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function creation_site_virtuel_theme_suggestions_site_internet_entity(array $variables) {
  $suggestions = [];
  $entity = $variables['elements']['#site_internet_entity'];
  $sanitized_view_mode = strtr($variables['elements']['#view_mode'], '.', '_');
  
  $suggestions[] = 'site_internet_entity__' . $sanitized_view_mode;
  $suggestions[] = 'site_internet_entity__' . $entity->bundle();
  $suggestions[] = 'site_internet_entity__' . $entity->bundle() . '__' . $sanitized_view_mode;
  $suggestions[] = 'site_internet_entity__' . $entity->id();
  $suggestions[] = 'site_internet_entity__' . $entity->id() . '__' . $sanitized_view_mode;
  return $suggestions;
}

